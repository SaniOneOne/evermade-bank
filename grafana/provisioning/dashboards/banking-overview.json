      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean","max"] } },
      "targets": [
        { "expr": "sum by (path) (rate(banking_http_requests_total[1m]))", "legendFormat": "{{path}}", "refId": "A" }
      ],
      "title": "API RPS by path",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
