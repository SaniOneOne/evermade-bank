      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, path) (rate(banking_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p50 {{path}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, path) (rate(banking_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95 {{path}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, path) (rate(banking_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p99 {{path}}", "refId": "C" }
      ],
      "title": "API latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
