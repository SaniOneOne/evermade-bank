{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull","max"] } },
      "targets": [
        { "expr": "sum by (state) (pg_stat_activity_count{datname=\"evermade_bank\"})", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "title": "Postgres: activity by state",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname=\"evermade_bank\"}", "legendFormat": "backends", "refId": "A" },
        { "expr": "pg_settings_max_connections", "legendFormat": "max_connections", "refId": "B" }
      ],
      "title": "Postgres: connections vs max",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"evermade_bank\"}[1m])", "legendFormat": "commits/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"evermade_bank\"}[1m])", "legendFormat": "rollbacks/s", "refId": "B" }
      ],
      "title": "Postgres: transactions rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "pg_locks_count{mode=\"exclusiveLock\"}", "legendFormat": "exclusive", "refId": "A" },
        { "expr": "pg_locks_count{mode=\"shareLock\"}", "legendFormat": "share", "refId": "B" }
      ],
      "title": "Postgres: locks",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_read{datname=\"evermade_bank\"}[1m]) * 8192", "legendFormat": "read B/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_blks_hit{datname=\"evermade_bank\"}[1m]) * 8192", "legendFormat": "hit B/s", "refId": "B" }
      ],
      "title": "Postgres: disk/cache I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit{datname=\"evermade_bank\"}[1m]) / (rate(pg_stat_database_blks_hit{datname=\"evermade_bank\"}[1m]) + rate(pg_stat_database_blks_read{datname=\"evermade_bank\"}[1m]))", "legendFormat": "cache hit ratio", "refId": "A" }
      ],
      "title": "Postgres: cache hit ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["evermade", "postgres"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
