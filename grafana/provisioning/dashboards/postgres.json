{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [
        { "expr": "container_cpu_utilization_ratio{container_name=\"emb-postgres\"} * 100", "legendFormat": "CPU %", "refId": "A" }
      ],
      "title": "Postgres CPU (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [
        { "expr": "container_memory_usage_total_bytes{container_name=\"emb-postgres\"}", "legendFormat": "RAM used", "refId": "A" },
        { "expr": "container_memory_usage_limit_bytes{container_name=\"emb-postgres\"}", "legendFormat": "RAM limit", "refId": "B" }
      ],
      "title": "Postgres RAM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname=\"evermade_bank\"}", "legendFormat": "connections", "refId": "A" },
        { "expr": "pg_settings_max_connections", "legendFormat": "max_connections", "refId": "B" }
      ],
      "title": "Postgres: connections vs max",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"evermade_bank\"}[1m])", "legendFormat": "commits/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"evermade_bank\"}[1m])", "legendFormat": "rollbacks/s", "refId": "B" }
      ],
      "title": "Postgres: transactions rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "pg_locks_count{mode=\"exclusiveLock\"}", "legendFormat": "exclusive locks", "refId": "A" },
        { "expr": "pg_locks_count{mode=\"shareLock\"}", "legendFormat": "share locks", "refId": "B" }
      ],
      "title": "Postgres: locks",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit{datname=\"evermade_bank\"}[1m]) / (rate(pg_stat_database_blks_hit{datname=\"evermade_bank\"}[1m]) + rate(pg_stat_database_blks_read{datname=\"evermade_bank\"}[1m]))", "legendFormat": "cache hit ratio", "refId": "A" }
      ],
      "title": "Postgres: cache hit ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["evermade", "postgres"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "EverMade Bank — Postgres",
  "uid": "emb-postgres",
  "version": 1
}
