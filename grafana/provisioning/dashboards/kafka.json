  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [
        { "expr": "container_cpu_utilization_ratio{container_name=\"emb-kafka\"} * 100", "legendFormat": "CPU %", "refId": "A" }
      ],
      "title": "Kafka CPU (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [
        { "expr": "container_memory_usage_total_bytes{container_name=\"emb-kafka\"}", "legendFormat": "RAM used", "refId": "A" },
        { "expr": "container_memory_usage_limit_bytes{container_name=\"emb-kafka\"}", "legendFormat": "RAM limit", "refId": "B" }
      ],
      "title": "Kafka RAM",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        { "expr": "sum(kafka_consumergroup_lag{consumergroup=\"emb-worker\"})", "refId": "A" }
      ],
      "title": "Total consumer lag",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "kafka_consumergroup_lag{consumergroup=\"emb-worker\"}", "legendFormat": "{{topic}}/p{{partition}}", "refId": "A" }
      ],
      "title": "Consumer lag per partition",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "rate(kafka_topic_partition_current_offset{topic=\"transactions\"}[1m])", "legendFormat": "produced/s", "refId": "A" },
        { "expr": "rate(kafka_consumergroup_current_offset{consumergroup=\"emb-worker\",topic=\"transactions\"}[1m])", "legendFormat": "consumed/s", "refId": "B" }
      ],
      "title": "Kafka throughput (transactions)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "rate(container_network_io_usage_rx_bytes_total{container_name=\"emb-kafka\"}[1m])", "legendFormat": "RX Bps", "refId": "A" },
        { "expr": "rate(container_network_io_usage_tx_bytes_total{container_name=\"emb-kafka\"}[1m])", "legendFormat": "TX Bps", "refId": "B" }
      ],
      "title": "Kafka network I/O",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        { "expr": "kafka_topic_partitions{topic=\"transactions\"}", "legendFormat": "partitions", "refId": "A" },
        { "expr": "kafka_consumergroup_members{consumergroup=\"emb-worker\"}", "legendFormat": "consumer members", "refId": "B" },
        { "expr": "container_restarts_total{container_name=\"emb-kafka\"}", "legendFormat": "kafka restarts", "refId": "C" }
      ],
      "title": "Kafka topology & restarts",
      "type": "timeseries"
    }
  ],
